PORT=3001
MONGODB_URI=mongodb://localhost:27017/music-streaming

AWS_REGION=us-east-1
AWS_S3_BUCKET=your-private-bucket-name

# Optional when running on EC2/ECS/EKS/Lambda with IAM roles.
# Required for local Docker Compose unless you mount/configure another AWS credential provider.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REQUIRE_EXPLICIT_CREDENTIALS=true

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YT_DLP_PATH=yt-dlp
MAX_UPLOAD_SIZE_MB=500
CLIENT_ORIGIN=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth Client ID (Google Cloud Console > APIs & Services > Credentials).
# Must match VITE_GOOGLE_CLIENT_ID on the client - required for "Continue with Google" to work.
GOOGLE_CLIENT_ID=
